{
  "name": "maputo",
  "version": "0.2.0",
  "description": "Browser annotation recorder: Playwright + Agentation UI for automation development",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "build:bundle": "tsx scripts/build-bundle.ts",
    "record": "tsx src/index.ts record",
    "run:script": "tsx src/index.ts run",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "agentation": "^2.2.1",
    "playwright": "^1.50.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
